
from collections import deque

start = (1, 2, 3, 4, 0, 6, 7, 5, 8)
goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)

q = deque([(start, [])])
visited = {start}

while q:
    state, path = q.popleft()

    if state == goal:
        print("Solution:", path + [state])
        break

    pos = state.index(0)

    for move in [-3, 3, -1, 1]:
        new = pos + move

        if 0 <= new < 9 and not (move == -1 and pos % 3 == 0) and not (move == 1 and pos % 3 == 2):
            s = list(state)
            s[pos], s[new] = s[new], s[pos]
            s = tuple(s)

            if s not in visited:
                visited.add(s)
                q.append((s, path + [state]))
