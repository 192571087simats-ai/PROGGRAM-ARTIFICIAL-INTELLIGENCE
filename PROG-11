
import heapq

goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)

def manhattan(state):
    distance = 0
    for i, value in enumerate(state):
        if value != 0:
            goal_pos = goal.index(value)
            distance += abs(i // 3 - goal_pos // 3)
            distance += abs(i % 3 - goal_pos % 3)
    return distance

def solve(start):
    queue = [(manhattan(start), 0, start, [])]
    visited = set()

    while queue:
        f, cost, state, path = heapq.heappop(queue)

        if state == goal:
            print("Optimal Solution:")
            for step in path + [state]:
                print(step[:3])
                print(step[3:6])
                print(step[6:])
                print()
            print("Total Moves:", cost)
            return

        if state in visited:
            continue

        visited.add(state)
        zero = state.index(0)
        row, col = zero // 3, zero % 3

        for dr, dc in [(0,1), (0,-1), (1,0), (-1,0)]:
            r, c = row + dr, col + dc

            if 0 <= r < 3 and 0 <= c < 3:
                new_pos = r * 3 + c
                new_state = list(state)
                new_state[zero], new_state[new_pos] = new_state[new_pos], new_state[zero]
                new_state = tuple(new_state)

                if new_state not in visited:
                    new_cost = cost + 1
                    heapq.heappush(queue, (new_cost + manhattan(new_state),
                                           new_cost, new_state,
                                           path + [state]))

start = (1, 2, 3,
         4, 0, 6,
         7, 5, 8)

solve(start)
