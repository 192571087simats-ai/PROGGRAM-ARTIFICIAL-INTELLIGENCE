def astar(graph, h, start, goal):
    open_list = [(h[start], 0, start)]

    while open_list:
        open_list.sort()
        f, g, node = open_list.pop(0)

        print(node, "g(n):", g, "h(n):", h[node], "f(n):", f)

        if node == goal:
            print("Goal reached! Total cost:", g)
            return

        for child, cost in graph[node]:
            open_list.append((g + cost + h[child],
                              g + cost, child))

graph = {
    'A': [('B', 1), ('C', 3)],
    'B': [('D', 2), ('E', 4)],
    'C': [('E', 2)],
    'D': [],
    'E': []
}

h = {'A': 5, 'B': 4, 'C': 2, 'D': 3, 'E': 0}

astar(graph, h, 'A', 'E')
